{
  "bundle": {
    "targets": "nsis",
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "offlineInstaller"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "windows-installer-hooks.nsh",
        "installMode": "currentUser",
        "startMenuFolder": "Dance One Radio"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
