{
  "name": "dance-one-radio-desktop",
  "version": "1.0.0",
  "description": "Dance One Radio Desktop App",
  "main": "main.js",
  "author": "Dance One Radio",
  "license": "MIT",
  "homepage": "https://www.danceoneradio.com",
  "scripts": {
    "start": "electron .",
    "clean": "rmdir /s /q dist",
    "build:win": "electron-builder --win --x64 --config.win.target=portable --config.portable.useZip=false"
  },
  "build": {
    "appId": "com.danceoneradio.app",
    "productName": "DanceOneRadio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "DanceOneRadio-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}