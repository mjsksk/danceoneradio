{
  "name": "dance-one-radio-desktop",
  "version": "1.0.0",
  "description": "Dance One Radio Desktop App - Your favorite electronic music station",
  "main": "main.js",
  "author": "Dance One Radio",
  "license": "MIT",
  "homepage": "https://www.danceoneradio.com",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --win --linux --mac",
    "dist": "npm run build:win",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.danceoneradio.desktop",
    "productName": "DanceOneRadio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "dist/**/*"
    ],
    "asarUnpack": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dance One Radio",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "keywords": [
    "radio",
    "dance",
    "electronic",
    "music",
    "streaming",
    "desktop"
  ],
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}